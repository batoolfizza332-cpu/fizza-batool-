# The production URL of this site. Used to derive metadataBase, canonical
# URLs, sitemap.xml, robots.txt, Open Graph URLs, and JSON-LD URLs - all of
# which read from the single centralized siteConfig.siteUrl (src/lib/site-config.ts).
# Set this to the real production domain before deploying.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

# --- Backend (BACKEND STEP 2 foundation - no live project connected yet) ---

# Postgres connection string used by Drizzle (drizzle.config.ts) and the
# server-side DB client. Get this from your Supabase project's database
# settings once a project is provisioned. Never expose this to the client.
DATABASE_URL=postgresql://user:password@host:5432/database

# Public Supabase project URL and anon (publishable) key, used by the
# browser-facing Supabase client. Safe to expose - do not put the service
# role key here or in any NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
